{
  "extends": "solhint:recommended",
  "rules": {
    "no-console": "off",
    "code-complexity": [
      "error",
      8
    ],
    "compiler-version": [
      "error",
      "=0.8.30"
    ],
    "func-name-mixedcase": "off",
    "func-visibility": [
      "error",
      {
        "ignoreConstructors": true
      }
    ],
    "max-line-length": [
      "error",
      120
    ],
    "named-parameters-mapping": "warn"
  }
}